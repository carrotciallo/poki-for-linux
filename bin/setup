#!/bin/sh
set -eu
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
os=$(uname -s)
if [ "$os" != Darwin ] && [ "$os" != Linux ]; then
  echo 'Poki MCP requires macOS or Linux.' >&2
  exit 1
fi
require_tools() {
  install=$1
  shift
  for tool in "$@"; do
    if ! command -v "$tool" >/dev/null 2>&1; then
      echo "Missing prerequisite: $tool. $install Then run ./bin/setup again." >&2
      exit 1
    fi
  done
}
if [ "$os" = Darwin ]; then
  require_tools 'Install the full Xcode from the App Store and open it once. It includes this tool.' git python3 xcrun xcodebuild
else
  require_tools 'Install git with your package manager.' git
  require_tools 'Install Python 3 with your package manager.' python3
  require_tools 'Install usbmuxd and start it (Arch: sudo pacman -S usbmuxd; Debian/Ubuntu: sudo apt install usbmuxd). It is how Linux hosts talk to the iPhone over USB. Then run ./bin/setup again.' usbmuxd
  require_tools 'Install tesseract with its language data (Arch: sudo pacman -S tesseract tesseract-data-chi_sim tesseract-data-eng tesseract-data-jpn; Debian/Ubuntu: sudo apt install tesseract-ocr tesseract-ocr-chi-sim tesseract-ocr-jpn). It is the OCR recognizer on Linux, standing in for the macOS Vision helper. Then run ./bin/setup again.' tesseract
fi
if [ "$os" = Darwin ]; then
  node_hint='Install Node.js 24 or newer from https://nodejs.org or with: brew install node.'
  ffmpeg_hint='Install FFmpeg, which includes ffprobe, with: brew install ffmpeg.'
else
  node_hint='Install Node.js 24 or newer from https://nodejs.org or with your package manager.'
  ffmpeg_hint='Install FFmpeg, which includes ffprobe, with your package manager.'
fi
require_tools "$node_hint" node npm
require_tools 'Install the Rust toolchain from https://rustup.rs and open a new terminal.' cargo rustc
require_tools "$ffmpeg_hint" ffmpeg ffprobe
node -e 'if (Number(process.versions.node.split(".")[0]) < 24) { console.error("Poki MCP requires Node.js 24 or newer. Install it from https://nodejs.org."); process.exit(1); }'
if [ "$os" = Darwin ]; then
  if ! xcodebuild -version >/dev/null 2>&1 || ! xcrun --find swiftc >/dev/null 2>&1 || ! xcrun --find clang >/dev/null 2>&1; then
    echo 'Poki MCP needs the full Xcode. The Command Line Tools alone are not enough. Install Xcode from the App Store, then run: sudo xcode-select -s /Applications/Xcode.app/Contents/Developer && sudo xcodebuild -runFirstLaunch' >&2
    exit 1
  fi
fi
idevice_dir="$project_dir/.deps/idevice"
revision=89702099f4d7552f704f93b4526756abda319ceb
mkdir -p "$project_dir/.deps"
if [ ! -e "$idevice_dir" ]; then
  git clone https://github.com/jkcoxson/idevice.git "$idevice_dir"
  git -C "$idevice_dir" checkout --detach "$revision"
fi
if [ ! -d "$idevice_dir/.git" ] || [ "$(git -C "$idevice_dir" rev-parse HEAD)" != "$revision" ]; then
  echo 'The existing .deps/idevice checkout is not the required revision; it was left unchanged.' >&2
  exit 1
fi
if [ -n "$(git -C "$idevice_dir" status --porcelain)" ]; then
  echo 'The existing .deps/idevice checkout has local changes; it was left unchanged. Use an unmodified checkout of the pinned revision.' >&2
  exit 1
fi
(cd "$idevice_dir" && cargo build --locked --release -p idevice-tools --bin idevice-tools --bin idevice_id -j 4)
cd "$project_dir"
if [ "$os" = Linux ]; then
  # sharp's install script tries a source build when its prebuilt packages
  # were skipped; skipping scripts and verifying the load is more reliable.
  npm ci --ignore-scripts --no-audit --no-fund
  node bin/setup-linux-deps.mjs
else
  npm ci --no-audit --no-fund
fi
npm run build:native
